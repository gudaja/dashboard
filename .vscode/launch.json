{
    // The package itself has no entry point; F5 runs the example app.
    // Pick the device (Linux, Chrome, ...) in the status bar.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "example",
            "cwd": "example",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "example (profile mode)",
            "cwd": "example",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "example (release mode)",
            "cwd": "example",
            "program": "lib/main.dart",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
